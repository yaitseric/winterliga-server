# Kopieren nach .env und ausfüllen: cp .env.example .env
# Die .env selbst wird nie versioniert.

# Auth-Key aus der Tailscale-Admin-Konsole (Settings → Keys).
# Am besten mit einem Tag erzeugen, der in der ACL das Attribut "funnel" hat.
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX

# Passwort für die Orga, mindestens 8 Zeichen. Ohne Passwort startet der Server nicht.
ORGA_PASSWORD=
